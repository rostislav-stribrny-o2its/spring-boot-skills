<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: backend/backend-service/pom.xml - a runnable application.
     scheduler-service is the same minus the API part: no api-spec link, no generator, no lib-web,
     no lib-security, no Lombok-in-generated-code reason; webmvc only to serve actuator on the
     management port. The role is the module, never a Spring profile.
     Not yet verified by a build in this repository. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app</groupId>
        <artifactId>backend</artifactId>
        <version>0.0.1</version>
    </parent>

    <artifactId>backend-service</artifactId>

    <dependencies>
        <!-- Build order only: the spec is exported before code is generated from it.
             Nothing of api-spec / api-model reaches the classpath (wildcard exclusion);
             ArchUnit forbids app.api.. and app.apispec.. in app.backend.. anyway. -->
        <dependency>
            <groupId>app</groupId>
            <artifactId>api-spec</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
            </exclusions>
        </dependency>

        <!-- Shared libraries, composed explicitly with @Import in BackendServiceApplication -->
        <dependency><groupId>app</groupId><artifactId>lib-core</artifactId></dependency>
        <dependency><groupId>app</groupId><artifactId>lib-db</artifactId></dependency>
        <dependency><groupId>app</groupId><artifactId>lib-web</artifactId></dependency>
        <dependency><groupId>app</groupId><artifactId>lib-security</artifactId></dependency>

        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
        <!-- Tracing: trace ID in the MDC and the correlation header (be-correlation-logging) -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-opentelemetry</artifactId></dependency>
        <!-- Migrations: without the starter they silently never run (db-flyway-migrations) -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
        <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
        <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
        <!-- Generated code uses jakarta.annotation.Generated -->
        <dependency><groupId>jakarta.annotation</groupId><artifactId>jakarta.annotation-api</artifactId></dependency>

        <!-- MapStruct annotations: compile scope; the processor runs from the parent's annotationProcessorPaths -->
        <dependency><groupId>org.mapstruct</groupId><artifactId>mapstruct</artifactId></dependency>
        <!-- Lombok: provided; also needed by the generated DTOs (be-api-contract-first) -->
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>

        <!-- Tests -->
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.github.dasniko</groupId><artifactId>testcontainers-keycloak</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-testcontainers</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-postgresql</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Code generation from the committed spec: see be-api-contract-first,
                 templates/backend-service-openapi-fragment.xml -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
